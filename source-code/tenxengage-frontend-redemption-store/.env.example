VITE_API_BASE_URL=http://localhost:8080/api/v1

# ── Dev Bug Reporter ──────────────────────────────────────────────────────────
# These variables are only read by the Vite dev server (Node.js) — they are
# never injected into the browser bundle.
#
# BUG_REPORTER_NAME — your name as it appears on captured bug reports and
# ClickUp tickets. Pre-fills the "Reported by" field in the popup. The popup
# allows overriding it per-report. Defaults to "Anonymous" if unset.
#
# BUG_REPORTER_AUTO_TICKET — set to "true" to automatically create a ClickUp
# task every time the in-app bug reporter submits evidence. When false (or
# unset), evidence is still captured to bugs-evidence/ but no ticket is filed.
#
# CLICKUP_API_TOKEN — your personal ClickUp API token.
#   Get it at: https://app.clickup.com/settings/apps → "API Token"
#
# CLICKUP_BUGS_LIST_ID — the numeric ClickUp List ID where bug tasks should
# land. Find it in the ClickUp URL when you open the list:
#   https://app.clickup.com/<team>/<space>/list/<LIST_ID>
#
# VITE_BUG_REPORTER_NETWORK_WINDOW_MS — how far back (in ms) to include network
# calls when no session is active. Defaults to 60000 (last 60 seconds).
#
# VITE_BUG_REPORTER_NOISE_ENDPOINTS — comma-separated URL substrings for
# high-frequency polling endpoints that should be suppressed from the HAR unless
# they fail (status >= 400 or network error). The notifications unread-count
# poller is suppressed by default; add more here if needed.
#   Example: /notifications/unread-count,/some/other/poll
#
# Copy this file to .env.local (gitignored) and fill in real values.
BUG_REPORTER_NAME=
BUG_REPORTER_AUTO_TICKET=true
CLICKUP_API_TOKEN=pk_12847192_F7U8ECX0F54IQAFNYA5E9XN61MEBN7CN
CLICKUP_BUGS_LIST_ID=901614449217
VITE_BUG_REPORTER_NETWORK_WINDOW_MS=60000
VITE_BUG_REPORTER_NOISE_ENDPOINTS=/notifications/unread-count

# ── QA Cloud Bug Reporter ─────────────────────────────────────────────────────
# These three vars enable the in-app bug reporter in cloud-deployed QA builds.
# They are baked into the bundle at build time (vite build) — NOT runtime.
#
# DO NOT put them in .env.local — Vite ignores .env.local during builds.
# Set them as CI/CD pipeline env vars for the QA build step only.
# Leave all three blank here; local dev works without them (DEV flag is enough).
#
# VITE_ENABLE_BUG_REPORTER — set to "true" to show the bug reporter in a
#   non-DEV build (e.g. QA). Without this, the bug button is invisible in
#   any built/deployed frontend regardless of other vars.
#
# VITE_BUG_CAPTURE_URL — full URL of the Cloud Run /api/bug-capture endpoint.
#   Example: https://tenxengage-chat-bug-bot-xxxx.run.app/api/bug-capture
#
# VITE_BUG_CAPTURE_API_KEY — shared secret sent as X-Bug-Capture-Key header.
#   Must match BUG_CAPTURE_API_KEY set in the Cloud Run service.
#   Visible in the JS bundle — acceptable for QA (write-only risk).
VITE_ENABLE_BUG_REPORTER=
VITE_BUG_CAPTURE_URL=
VITE_BUG_CAPTURE_API_KEY=
