POSTGRES_DB=tenxengage
POSTGRES_USER=tenxengage
POSTGRES_PASSWORD=localdev
POSTGRES_PORT=5432
JWT_SECRET=your-256-bit-secret-key-change-in-production

# Resend (email)
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM=onboarding@resend.dev
MAIL_ENABLED=true

# Anthropic (AI Copilot)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Connector encryption (32-char key for AES-256)
CONNECTOR_ENCRYPTION_KEY=change-this-to-a-32-char-secret!

# Seed data (set to true once to populate demo data, then set back to false)
SEED_ENABLED=false

# Storage (s3 | gcp | local)
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=incentive-documents
# GCP-specific (only when STORAGE_PROVIDER=gcp)
# GCP_PROJECT_ID=your-gcp-project-id
# Local-specific (only when STORAGE_PROVIDER=local)
# STORAGE_LOCAL_BASE_DIR=./storage-data
